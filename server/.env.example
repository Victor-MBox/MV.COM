# Обработчик формы (server/contact.js). Локально: скопировать в server/.env (файл в .gitignore) и запустить `npm run server`
# из корня проекта. На боевом сервере те же переменные лежат в /etc/matsakov-victor.com/contact.env — файл создаёт
# deploy/server-setup.sh, заполнить от root и перезапустить: systemctl restart mvcom-contact

# --- Telegram (уведомление) -----------------------------------------------------------------------------------------
# Токен бота — от @BotFather. chat_id: написать боту /start, открыть https://api.telegram.org/bot<ТОКЕН>/getUpdates
# и взять result[].message.chat.id. Для группы или канала — его id (отрицательное число), бота добавить участником
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Что уходит в Telegram: notice (по умолчанию) — только номер заявки, время и тема, содержимое формы не пересылается
# (ТЗ по документам от 22.10.2026, §8; политика /privacy описывает именно этот режим); full — полный текст заявки.
# Включая full, добавьте Telegram в получатели данных в документах (src/data/legal.ts) и поднимите их редакцию
# TELEGRAM_CONTENT=notice

# --- Почта — основной канал доставки заявки ------------------------------------------------------------------------
# SMTP почтового ящика на домене (у Beget: smtp.beget.com, порт 465, логин — полный адрес ящика).
# Без SMTP_HOST, SMTP_USER и SMTP_PASS содержимое заявки доставить некуда (кроме TELEGRAM_CONTENT=full) — форма получает 503
SMTP_HOST=
SMTP_PORT=465
# По умолчанию TLS сразу (true) для порта 465, иначе STARTTLS; задать явно только если провайдер требует иного
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# От кого (по умолчанию SMTP_USER — у большинства провайдеров адрес должен совпадать с логином) и кому (по умолчанию SMTP_USER)
MAIL_FROM=
MAIL_TO=

# --- Записи о согласии ---------------------------------------------------------------------------------------------
# Папка журнала согласий consents.jsonl (номер заявки, время UTC, форма, редакция согласия — без имени, контакта и текста).
# На сервере её даёт systemd (StateDirectory=mvcom-contact → /var/lib/mvcom-contact, переменная STATE_DIRECTORY);
# локально задать явно, например .data (в .gitignore и исключена из деплоя). Без папки заявки не принимаются (503)
CONSENT_LOG_DIR=.data
# Срок хранения записей — как у обращений без договора (src/data/legal.ts RETENTION.leadsDays)
# CONSENT_RETENTION_DAYS=180

# --- Сеть и защита от спама (значения по умолчанию) --------------------------------------------------------------
# Заявки принимаются только с запросов, у которых Origin совпадает с Host (сайт за nginx, dev-сервер за прокси Vite).
# Дополнительные адреса, если сайт открывают с другого origin (туннель, превью), — через запятую:
# ALLOWED_ORIGINS=https://preview.example.com
# LISTEN_HOST=127.0.0.1
# PORT=3721      # тот же порт — в proxy_pass nginx-конфига и в прокси Vite
# RATE_LIMIT=5          # не больше стольких заявок с одного IP…
# RATE_WINDOW_MIN=10    # …за столько минут
