# Публичный адрес сайта — единственная настройка для canonical и og:url (src/data/meta.ts → SITE_URL).
# Указать подтверждённый домен в .env.production или в переменных окружения сборки на хостинге, например:
# VITE_SITE_URL=https://example.com
# Пустое значение, localhost и адреса не по http(s) игнорируются — canonical и og:url тогда не выводятся.
VITE_SITE_URL=
